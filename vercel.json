{
  "framework": "vite",
  "buildCommand": "npm run build",
  "outputDirectory": "dist",
  "rewrites": [
    {
      "source": "/((?!assets/|portfolio/|testimonials/|modules/|images/|.*\\.(?:js|css|webp|jpg|jpeg|png|gif|svg|ico|json|woff2?|ttf|eot)).*)",
      "destination": "/index.html"
    }
  ]
}
